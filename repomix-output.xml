                                                                        />
                                                                    </td>
                                                                    
                                                                    <td className="border border-slate-200 p-2 align-top">
                                                                        <AdminNoteForm 
                                                                            orderId={order.id} 
                                                                            item={item} 
                                                                            onSubmit={handleNoteSubmit}
                                                                            onCancel={handleCancelNote}
                                                                        />
                                                                    </td>
