                                                            <th className="p-2 font-semibold">URL</th>
                                                            <th className="p-2 font-semibold w-32">価格</th>
                                                            <th className="p-2 font-semibold w-20 text-center">数量</th>
                                                            <th className="p-2 font-semibold">商品ステータス</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
