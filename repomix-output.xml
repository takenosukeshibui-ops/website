                                                    defaultValue={order.tracking_number || ''}
                                                    onFocus={(e) => {
                                                        const target = e.target
                                                        setTimeout(() => target.select(), 0)
                                                    }}
                                                    className="border border-slate-300 p-1 rounded text-xs w-28"
