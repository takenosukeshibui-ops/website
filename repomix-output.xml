            prevOrders.map((order) => {
                if (order.id !== orderId) return order
                const tempOrder = { ...order, shipping_fee: shippingFee, total_amount: totalAmount }
                return {
                    ...tempOrder,
                    status: calculateOrderStatus(tempOrder),
                }
            })
        )

        // 編集モード解除
        setEditingInvoiceOrderIds((prev) => {
            const next = new Set(prev)
            next.delete(orderId)
            return next
        })

        // 2. サーバー処理実行
        await sendInvoice(orderId, shippingFee, totalAmount)
    }

    // 発送完了ハンドラ
    const handleShip = async (orderId: string, formData: FormData) => {
        const trackingNumber = (formData.get('trackingNumber') as string) || ''

        // 1. ローカルStateを即時更新（画面バッジを『国際発送済み』へ）
        setOrders((prevOrders) =>
            prevOrders.map((order) => {
                if (order.id !== orderId) return order
                const tempOrder = { ...order, tracking_number: trackingNumber }
                return {
                    ...tempOrder,
                    status: calculateOrderStatus(tempOrder),
                }
            })
        )

        // 編集モード解除
        setEditingShipOrderIds((prev) => {
            const next = new Set(prev)
            next.delete(orderId)
            return next
        })

        // 2. サーバー処理実行
        await shipOrder(orderId, trackingNumber)
