                                                        <span className="font-bold text-amber-700">{(order.total_amount || 0).toLocaleString()}円</span>
                                                    </div>
                                                    <div className="flex items-center gap-2">
                                                        <WiseInvoiceLinkButton order={order} />
                                                        <button
                                                            type="button"
