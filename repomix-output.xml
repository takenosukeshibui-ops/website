                                                        <button
                                                            type="button"
                                                            onClick={() => handleMarkAsPaymentRequired(order)}
                                                            className="px-2 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded text-xs shadow-sm transition-colors whitespace-nowrap"
