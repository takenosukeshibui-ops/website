        .eq('item_id', itemId)

    const orderId = orderItemRows && orderItemRows.length > 0 ? orderItemRows[0].order_id : null

    // 3. 注文全体のステータスを判定して更新
    if (orderId) {
        // 現在の注文情報を取得（決済待ちや発送完了を上書きしないため）
        const { data: currentOrder } = await supabase
            .from('orders')
