        setOrders((prevOrders) =>
            prevOrders.map((o) => {
                if (o.id !== order.id) return o
                const tempOrder = { ...o, status: 'pending' }
                return { 
                    ...tempOrder,
                    status: calculateOrderStatus(tempOrder) 
