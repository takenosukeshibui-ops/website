                                                </div>
                                                <button
                                                    type="button"
                                                    onClick={() => toggleInvoiceEdit(order.id)}
                                                    className="text-[10px] text-blue-600 hover:underline whitespace-nowrap font-medium"
                                                >
                                                    変更
                                                </button>
                                            </div>
                                        ) : (
                                            <form action={handleInvoice.bind(null, order.id)} className="flex items-center gap-1.5">
                                                <CurrencyInput
                                                    name="shippingFee"
