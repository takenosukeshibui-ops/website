                                                <span className="font-mono font-bold text-slate-800 text-sm">
                                                    {itemsSubtotal > 0 ? `${itemsSubtotal.toLocaleString()} 円` : '計算中'}
                                                </span>
                                            </div>
                                            {hasInvoice && (
                                                <div className="border-l border-slate-300 pl-4">
