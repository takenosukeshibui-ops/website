            order_number,
            status,
            shipping_fee,
            total_amount,
            tracking_number,
            created_at,
            order_items (
                id,
                quantity,
                items (
                    id,
                    title,
                    price,
                    status,
                    url
                )
            )
        `)
        .order('order_number', { ascending: false })

    if (error) {
        console.error('注文データの取得失敗:', error.message)
    }

    return <ClientAdminPage orders={orders || []} />
}
