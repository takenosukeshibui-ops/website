export default function ClientAdminPage({ orders: initialOrders }: { orders: any[] }) {
    // 注文データをローカルステートとして管理（画面の即時反映用）
    const [orders, setOrders] = useState(initialOrders)
    const [expandedOrders, setExpandedOrders] = useState<Set<string>>(new Set())

    // props が更新されたらステートも同期
    React.useEffect(() => {
        setOrders(initialOrders)
    }, [initialOrders])

    const toggleOrder = (orderId: string) => {
        setExpandedOrders((prev) => {
            const next = new Set(prev)
            if (next.has(orderId)) {
                next.delete(orderId)
            } else {
                next.add(orderId)
            }
            return next
        })
    }

    // 商品ステータスが変更された際にローカルの注文ステータスも再計算する関数
    const handleItemStatusUpdated = (orderId: string, itemId: string, newStatus: string) => {
        setOrders((prevOrders) =>
            prevOrders.map((order) => {
                if (order.id !== orderId) return order

                // 該当商品のステータスを更新
                const updatedOrderItems = order.order_items.map((oi: any) => {
                    const item = Array.isArray(oi.items) ? oi.items[0] : oi.items
                    if (item && item.id === itemId) {
                        return { ...oi, items: Array.isArray(oi.items) ? [{ ...item, status: newStatus }] : { ...item, status: newStatus } }
                    }
                    return oi
                })

                // 注文全体のステータスを再判定
                const allStatuses = updatedOrderItems.map((oi: any) => {
                    const item = Array.isArray(oi.items) ? oi.items[0] : oi.items
                    return item?.status
                })

                let calculatedOrderStatus = order.status

                // 決済待ち・発送済みでなければ注文ステータスをローカルでも更新
                if (!['payment_required', 'shipped'].includes(order.status)) {
                    if (allStatuses.every((s: string) => ['out_of_stock', 'cancelled'].includes(s))) {
                        calculatedOrderStatus = 'cancelled'
                    } else if (allStatuses.every((s: string) => s === 'pending')) {
                        calculatedOrderStatus = 'pending'
                    } else {
                        const activeStatuses = allStatuses.filter((s: string) => !['out_of_stock', 'cancelled'].includes(s))
                        if (activeStatuses.length > 0) {
                            if (activeStatuses.every((s: string) => s === 'in_warehouse')) {
                                calculatedOrderStatus = 'calculating'
                            } else if (activeStatuses.every((s: string) => s === 'purchased')) {
                                calculatedOrderStatus = 'procured'
                            } else if (activeStatuses.every((s: string) => ['purchased', 'in_warehouse'].includes(s))) {
                                calculatedOrderStatus = 'procured'
                            } else {
                                calculatedOrderStatus = 'pending'
                            }
                        }
                    }
                }

                return {
                    ...order,
                    status: calculatedOrderStatus,
                    order_items: updatedOrderItems,
                }
            })
        )
    }

    // 請求書送信ハンドラ
    const handleInvoice = async (orderId: string, formData: FormData) => {
        const shippingFee = Number(formData.get('shippingFee')) || 0
        const totalAmount = Number(formData.get('totalAmount')) || 0
        await sendInvoice(orderId, shippingFee, totalAmount)
    }

    // 発送完了ハンドラ
    const handleShip = async (orderId: string, formData: FormData) => {
