            {/* パスワード変更用トースト通知 */}
            {showPwToast && (pwState?.error || pwState?.success) && (
                <div className="fixed bottom-24 left-1/2 transform -translate-x-1/2 z-50 transition-opacity duration-300">
                    {pwState?.error && (
                        <div 
