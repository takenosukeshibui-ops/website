/**
 * 14. 追跡番号のクリア（削除） [UPDATED]
 */
export async function deleteShip(orderId: string) {
    const supabase = await createClient()

    const { error } = await supabase
        .from('orders')
        .update({ tracking_number: null })
        .eq('id', orderId)

