                                        </form>
                                    </td>
                                </tr>

                                {/* アコーディオン展開部分：商品一覧の子テーブル */}
                                {isExpanded && (
                                    <tr key={`${order.id}-items`} className="bg-slate-50/70">
                                        <td colSpan={6} className="border border-slate-300 p-4 pl-12">
                                            <div className="bg-white border border-slate-200 rounded shadow-inner p-3">
